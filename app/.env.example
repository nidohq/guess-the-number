# The `stellar` CLI loads this file, so values here reach `stellar scaffold`.

# Network from scaffold.yml to build for. Defaults to the network set with
# `stellar network use`, then `local`. A value set in your shell wins, e.g.
#   STELLAR_NETWORK=testnet npm start
# The frontend follows automatically: it reads the network from the generated
# clients in app-lib/clients.
# STELLAR_NETWORK=testnet

# Secrets referenced from scaffold.yml as ${env.NAME}, e.g. an RPC token:
# MAINNET_RPC_TOKEN=

# Prefix with "PUBLIC_" to make your own values available in frontend files.

# The Nido wallet the app connects to; unset, it is https://356.test.nido.fyi,
# the preview of nidohq/nido#356 on the separate M7 testnet deployment.
# Hosted Nido is testnet-only. Other networks keep the standard wallets.
PUBLIC_NIDO_BASE=https://356.test.nido.fyi

# Session calls go out from a key this browser keeps, funded by testnet
# Friendbot, as the preview wallet does: it runs without Nido's shared relayer.
# Unset, it is 1; 0 sends them to the relayer below instead. Testnet only.
PUBLIC_NIDO_LOCAL_SUBMITTER=1

# The relayer that submits session calls and pays their fees when
# PUBLIC_NIDO_LOCAL_SUBMITTER=0; unset, it is Nido's testnet relayer,
# https://nido.fly.dev.
# PUBLIC_NIDO_RELAYER=https://nido.fly.dev

