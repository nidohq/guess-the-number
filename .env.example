# Read by the `stellar` CLI (npm run dev, clients:testnet, deploy:testnet) and
# by Vite. Copy to .env; `npm run new-app` writes one for you.

# The network `npm run dev` builds clients for. Hosted Nido runs on testnet.
# `npm run deploy:testnet` deploys to testnet-dev and pins the new IDs under
# `testnet:` in scaffold.yml, so this stays `testnet`.
STELLAR_NETWORK=testnet

# The dev server's port. A Nido session key lives in the page origin's storage,
# and the origin includes the port, so the port is fixed (strictPort) rather
# than drifting when another app holds it. 5542 is the port `npm run new-app`
# gives an app named guess-the-number, so this example never shares an origin
# (and its session keys) with a fresh app on the template's 5173.
PORT=5542

# The path the built app is served under. GitHub Pages serves this repository
# at https://nidohq.github.io/guess-the-number/, so the Pages workflow builds
# with BASE_PATH=/guess-the-number/. Unset, the app is served from /.
# BASE_PATH=/guess-the-number/
